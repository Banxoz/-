#ifndef KVADRAT_H
#define KVADRAT_H
using namespace std;
#include <cmath> 
struct Roots {
    double x1;
    double x2;
    bool BOOL;
};
Roots kvadrat(double a, double b, double c) {
    Roots result;
    double discriminant = b * b - 4 * a * c;

    if (discriminant < 0) {
        result.BOOL = false;
        return result;
    }
    else {
        result.BOOL = true;
        result.x1 = (-b + sqrt(discriminant)) / (2 * a);
        result.x2 = (-b - sqrt(discriminant)) / (2 * a);
        return result;
    }
}

#endif 
#include <iostream>
#include "kvadrat.h"

using namespace std;

void print(double a, double b, double c) {
    Roots roots = kvadrat(a, b, c);

    cout << "Уравнение: " << a << "x² + " << b << "x + " << c << " = 0\n";
    if (!roots.has_real_roots) {
        cout << "Нет действительных корней.\n\n";
    }
    else if (roots.x1 == roots.x2) {
        cout << "Один корень: x = " << roots.x1 << "\n\n";
    }
    else {
        cout << "Два корня: x1 = " << roots.x1 << ", x2 = " << roots.x2 << "\n";
    }
}

int main() {
    // Примеры квадратных уравнений
    print(1, -5, 6);  // x² -5x +6 =0 → x1=3, x2=2
    print(1, 4, 4);   // x² +4x +4 =0 → x1=x2=-2
    print(1, 0, 1);   // x² +1 =0    → нет действительных корней
    print(2, -4, -6); // 2x² -4x -6=0 → x1=3, x2=-1

    return 0;
}
